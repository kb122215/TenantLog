<header class="site-header">
  <div class="header-inner">
    <a class="brand" href="/dashboard">
      <span class="brand-mark"
        ><i class="fa-solid fa-screwdriver-wrench" aria-hidden="true"></i
      ></span>
      <span class="brand-name">TenantLog</span>
    </a>

    <div class="header-user">
      <span class="user-name">
        <i
          class="fa-solid fa-<%= currentUser.role === 'landlord' ? 'building' : 'user' %>"
          aria-hidden="true"
        ></i>
        <%= displayName(currentUser) %>
      </span>
      <span class="role-tag"><%= currentUser.role %></span>
      <form class="inline-form" action="/logout" method="POST">
        <button
          class="btn btn-ghost btn-small"
          type="submit"
          aria-label="Log out"
        >
          <i class="fa-solid fa-right-from-bracket" aria-hidden="true"></i>
          <span class="hide-small">Log out</span>
        </button>
      </form>
    </div>
  </div>
</header>
